# Normalize to LF in the repo. The Cloudflare Workers build runs on Linux;
# checking in CRLF from Windows creates spurious diffs and breaks shebangs.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.wav binary
